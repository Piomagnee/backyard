const DEFAULT_SETTINGS = {open:false,date:'1er mai 2027',location:'Locaux scouts de Magnée, rue du Village 17, 4623 Magnée',soloPrice:'25',teamPrice:'100',iban:'',beneficiary:'Pionniers de Magnée',contact:EXPECTED_FROM,description:'Boucle d’environ 4,1 km et 100 m D+. Badgeage à mi-parcours et en fin de boucle ; dernière arrivée avant 22 h.',resultsStatus:'draft',siteUrl:''};
const REG_HEADERS=['Référence','Date de demande','Format','Équipe','Email contact','Téléphone','Coureurs','Places','Montant (€)','Suppléments supporters','Paiement','Mail reçu','Mail confirmé','Paiement vérifié le','Données techniques'];
function props_(){return PropertiesService.getScriptProperties();}
function book_(){const id=props_().getProperty('SPREADSHEET_ID');if(!id)throw Error('Exécutez initialiser depuis le Google Sheet.');return SpreadsheetApp.openById(id);}
function sheet_(name,headers){const b=book_();let s=b.getSheetByName(name);if(!s){s=b.insertSheet(name);s.appendRow(headers);s.setFrozenRows(1)}return s;}
function docs_(){return sheet_('Contenus',['Document','Partie','Texte']);}
function readDoc_(key,fallback){const rows=docs_().getDataRange().getValues().slice(1).filter(r=>r[0]===key).sort((a,b)=>Number(a[1])-Number(b[1]));return rows.length?rows.map(r=>r[2]).join(''):fallback;}
function writeDoc_(key,text){const s=docs_();const rows=s.getDataRange().getValues();for(let i=rows.length-1;i>=1;i--)if(rows[i][0]===key)s.deleteRow(i+1);let chunks=[];for(let i=0;i<text.length;i+=40000)chunks.push([key,chunks.length,text.slice(i,i+40000)]);if(!chunks.length)chunks.push([key,0,'']);s.getRange(s.getLastRow()+1,1,chunks.length,3).setValues(chunks);}
function getSettings_(){return Object.assign({},DEFAULT_SETTINGS,JSON.parse(readDoc_('settings','{}')));}
function getTemplates_(){return Object.assign({},DEFAULT_TEMPLATES,JSON.parse(readDoc_('templates','{}')));}
function getContents_(){return Object.assign({},DEFAULT_CONTENTS,JSON.parse(readDoc_('pages','{}')));}
function table_(name,headers){return sheet_(name,headers);}
function records_(){const s=table_('Inscriptions',REG_HEADERS);return s.getDataRange().getValues().slice(1).filter(r=>r[14]).map(r=>JSON.parse(r[14]));}
function safe_(x){let s=String(x==null?'':x);return /^[=+@-]/.test(s)?"'"+s:s;}
function saveRecord_(r){const s=table_('Inscriptions',REG_HEADERS),rows=s.getDataRange().getValues();let line=rows.findIndex((v,i)=>i>0&&v[0]===r.id)+1;const data=[r.id,r.created,r.kind,r.team,r.email,r.phone,r.runners.map(n=>n.first+' '+n.last).join(', '),r.seats,r.amount,r.extra_sausages,r.status,r.received_mail,r.mail,r.verified_at||'',JSON.stringify(r)].map((v,i)=>i<7?safe_(v):v);if(!line)line=s.getLastRow()+1;s.getRange(line,1,1,data.length).setValues([data]);}
function logs_(){return table_('Mails',['Identifiant','Dossier','Type','État','Dernière mise à jour','Erreur','Données techniques']).getDataRange().getValues().slice(1).filter(r=>r[6]).map(r=>JSON.parse(r[6]));}
function saveLog_(l){const s=table_('Mails',['Identifiant','Dossier','Type','État','Dernière mise à jour','Erreur','Données techniques']),rows=s.getDataRange().getValues();let n=rows.findIndex((r,i)=>i>0&&r[0]===l.id)+1;if(!n)n=s.getLastRow()+1;s.getRange(n,1,1,7).setValues([[l.id,l.registration_id,l.type,l.status,l.updated||'',safe_(l.error||''),JSON.stringify(l)]]);}
function results_(){return table_('Résultats',['Dossier','Boucles','Meilleur tour (secondes)','Mis à jour']).getDataRange().getValues().slice(1).filter(r=>r[0]).map(r=>({id:r[0],laps:Number(r[1]),best_seconds:r[2]===''?null:Number(r[2]),updated:r[3]}));}
function ready_(){return props_().getProperty('GMAIL_AUTHORIZED')==='true';}
function keyOk_(key){const expected=props_().getProperty('ADMIN_KEY');if(!expected||typeof key!=='string'||key.length!==expected.length)return false;let mismatch=0;for(let i=0;i<key.length;i++)mismatch|=key.charCodeAt(i)^expected.charCodeAt(i);return mismatch===0;}
function clean_(s,n){return typeof s==='string'?s.trim().slice(0,n||200):'';}
function now_(){return new Date().toISOString();}
function publicState_(){const s=getSettings_();return Object.assign({},s,{remaining:250-records_().filter(r=>r.status!=='cancelled').reduce((n,r)=>n+r.seats,0),hasGpx:!!readDoc_('gpx',''),contents:getContents_()});}
function output_(d){return ContentService.createTextOutput(JSON.stringify(d)).setMimeType(ContentService.MimeType.JSON);}
function doGet(e){try{const action=e&&e.parameter&&e.parameter.action||'state';if(!['state','results','gpx'].includes(action))throw Error('Action non publique.');return output_(route_(action,{},'GET',false));}catch(e){return output_({ok:false,error:e.message});}}
function doPost(e){try{const raw=e&&e.postData&&e.postData.contents||'';if(raw.length>2500000)throw Error('Requête trop volumineuse.');const b=JSON.parse(raw),action=clean_(b.action,60),method=b.method==='GET'?'GET':'POST',admin=keyOk_(b.key);if(method==='GET'&&['state','results','gpx'].includes(action))return output_(route_(action,{},method,false));if(action!=='register'&&!admin)throw Error('Clé organisateur incorrecte.');const lock=LockService.getScriptLock();lock.waitLock(25000);try{return output_(route_(action,b.data||{},method,admin));}finally{lock.releaseLock();}}catch(e){return output_({ok:false,error:e.message});}}
function queue_(r,type){const id=r.id+':'+type;if(logs_().some(l=>l.id===id))return;saveLog_({id,registration_id:r.id,type,status:'queued',updated:now_(),sent_at:'',error:''});}
