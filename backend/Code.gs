 if(action==='state'&&method==='GET')return publicState_();
 if(action==='gpx'&&method==='GET')return {gpx:readDoc_('gpx','')};
 if(action==='results'&&method==='GET'){if(Date.now()<EVENT_END)return {status:'upcoming',rows:[]};if(s.resultsStatus!=='final')return {status:'draft',rows:[]};const all=records_();return {status:'final',rows:results_().map(t=>{let r=all.find(r=>r.id===t.id&&r.status==='paid');return r?{id:r.id,kind:r.kind,name:r.team||r.runners.map(n=>n.first+' '+n.last).join(', '),laps:t.laps,best_seconds:t.best_seconds,updated:t.updated}:null}).filter(Boolean)};}
 if(action==='register'){
  if(!s.open)throw Error('Les inscriptions ne sont pas ouvertes.');const seats=b.kind==='solo'?1:b.kind==='team'?4:0;if(!seats||!Array.isArray(b.runners)||b.runners.length!==seats)throw Error('Inscrivez un coureur ou exactement quatre équipiers.');const runners=b.runners.map(r=>({first:clean_(r.first,60),last:clean_(r.last,60),medal:true})),email=clean_(b.email,150).toLowerCase(),phone=clean_(b.phone,30),team=seats===4?clean_(b.team,80):'',extra=b.extraSausages==null?0:b.extraSausages;
  if(runners.some(r=>!r.first||!r.last)||!/^\S+@\S+\.\S+$/.test(email)||!phone||seats===4&&!team)throw Error('Complétez les informations des coureurs et du contact.');if(!Number.isInteger(extra)||extra<0||extra>1000)throw Error('Quantité de suppléments invalide.');let all=records_().filter(r=>r.status!=='cancelled');if(all.some(r=>r.email===email))throw Error('Un dossier actif existe déjà pour cet email. Contactez l’organisation.');if(all.reduce((n,r)=>n+r.seats,0)+seats>250)throw Error('Il ne reste pas suffisamment de places.');const r={id:'BM-'+Utilities.getUuid().slice(0,8).toUpperCase(),created:now_(),kind:b.kind,team,email,phone,runners,seats,amount:seats*25+extra*4,extra_sausages:extra,status:'pending',received_mail:'queued',mail:'not_sent',verified_at:''};saveRecord_(r);queue_(r,'received');return {id:r.id,amount:r.amount,iban:s.iban,beneficiary:s.beneficiary,receiptMail:'queued'};
 }
 if(!admin)throw Error('Accès organisateur requis.');
 if(action==='admin')return {settings:s,occupied:250-publicState_().remaining,emailReady:ready_(),remindersScheduled:props_().getProperty('MAIL_SCHEDULE_ACTIVE')==='true',records:records_().reverse(),templates:getTemplates_(),contents:getContents_(),logs:logs_().reverse()};
 if(action==='settings'){let v={...s};['date','location','iban','beneficiary','contact','description','siteUrl'].forEach(k=>{if(k in b)v[k]=clean_(b[k],k==='description'?6000:500)});v.open=b.open===true;v.soloPrice='25';v.teamPrice='100';if(v.siteUrl&&!/^https:\/\//.test(v.siteUrl))throw Error('L’URL du site doit commencer par https://.');v.siteUrl=v.siteUrl.replace(/\/+$/,'');if(v.open&&(!v.iban||!v.beneficiary||!v.siteUrl||!ready_()))throw Error('Pour ouvrir, renseignez l’IBAN, le bénéficiaire, l’URL GitHub et connectez le service email.');writeDoc_('settings',JSON.stringify(v));return {ok:true};}
 if(action==='gpx'){if(typeof b.gpx!=='string'||b.gpx.length>2000000||!/<(?:[a-zA-Z0-9]+:)?gpx[\s>]/i.test(b.gpx)||/<!DOCTYPE|<!ENTITY/i.test(b.gpx))throw Error('Fichier GPX invalide.');writeDoc_('gpx',b.gpx);return {ok:true};}
 if(action==='templates'){if(!DEFAULT_TEMPLATES[b.type])throw Error('Modèle inconnu.');const subject=clean_(b.subject,250),body=clean_(b.body,15000);if(!subject||!body)throw Error('Objet et texte obligatoires.');const allowed=['contact_nom','reference','format','coureurs','montant','supplements','iban','beneficiaire','lien_parcours','lien_reglement','lien_infos','contact_organisation'];for(const m of (subject+'\n'+body).matchAll(/{{([a-z_]+)}}/g))if(!allowed.includes(m[1]))throw Error('Variable inconnue : '+m[1]);let all=getTemplates_();all[b.type]={...all[b.type],subject,body};writeDoc_('templates',JSON.stringify(all));return {ok:true};}
 if(action==='contents'){if(!['reglement','infos'].includes(b.page)||typeof b.text!=='string'||b.text.length>30000)throw Error('Contenu invalide.');const c=getContents_();c[b.page]=b.text;writeDoc_('pages',JSON.stringify(c));return {ok:true};}
 if(action==='action'){let r=records_().find(r=>r.id===b.id);if(!r)throw Error('Dossier introuvable.');if(b.action==='cancel'){if(r.status!=='pending')throw Error('Seul un dossier en attente peut être annulé par l’organisation.');r.status='cancelled';saveRecord_(r);return {message:'Dossier annulé, places libérées.'};}if(b.action!=='confirm'||r.status==='cancelled')throw Error('Action indisponible.');if(r.status==='paid'&&r.mail==='sent')return {message:'Ce dossier est déjà confirmé.'};r.status='paid';r.verified_at=r.verified_at||now_();r.mail=r.mail==='sent'?'sent':'queued';saveRecord_(r);queue_(r,'confirmed');return {message:'Paiement vérifié. Le mail de confirmation est placé dans la file d’envoi.'};}
 if(action==='results-import'){if(!Array.isArray(b.rows)||!b.rows.length||b.rows.length>250)throw Error('Import invalide.');let all=records_(),seen=new Set();b.rows.forEach(r=>{if(seen.has(r.id)||!all.some(x=>x.id===r.id&&x.status==='paid')||!Number.isInteger(r.laps)||r.laps<0||r.laps>500||!(r.laps===0&&r.best_seconds===null||r.laps>0&&typeof r.best_seconds==='number'&&isFinite(r.best_seconds)&&r.best_seconds>0&&r.best_seconds<=43200))throw Error('Résultat invalide, dupliqué ou non associé à un dossier payé.');seen.add(r.id)});let out=results_();b.rows.forEach(r=>{out=out.filter(x=>x.id!==r.id);out.push({...r,updated:now_()})});const sh=table_('Résultats',['Dossier','Boucles','Meilleur tour (secondes)','Mis à jour']);if(sh.getLastRow()>1)sh.getRange(2,1,sh.getLastRow()-1,4).clearContent();if(out.length)sh.getRange(2,1,out.length,4).setValues(out.map(r=>[r.id,r.laps,r.best_seconds==null?'':r.best_seconds,r.updated]));writeDoc_('settings',JSON.stringify({...s,resultsStatus:'draft'}));return {ok:true,count:b.rows.length};}
 if(action==='results-status'){if(!['draft','final'].includes(b.status))throw Error('Statut invalide.');if(b.status==='final'&&Date.now()<EVENT_END)throw Error('Publication possible après le 1er mai 2027 à 22 h.');if(b.status==='final'&&results_().some(r=>r.laps>0&&r.best_seconds==null))throw Error('Complétez tous les meilleurs tours.');writeDoc_('settings',JSON.stringify({...s,resultsStatus:b.status}));return {ok:true};}
 if(action==='schedule-mails'){if(!ready_())throw Error('Autorisez Gmail avant d’activer les envois.');for(const t of ScriptApp.getProjectTriggers())if(t.getHandlerFunction()==='traiterMails')ScriptApp.deleteTrigger(t);ScriptApp.newTrigger('traiterMails').timeBased().everyMinutes(5).create();props_().setProperty('MAIL_SCHEDULE_ACTIVE','true');return {message:'Traitement périodique activé. Les rappels sont prévus le 17 et le 30 avril 2027 à partir de 10 h, heure belge.'};}
 if(action==='process-mail'){if(!ready_())throw Error('Gmail n’est pas encore autorisé.');enqueueReminders_();const n=drainQueue_();return {message:n+' mails traités. Consultez le journal pour leur état.'};}
 if(action==='retry-mail'){const l=logs_().find(l=>l.id===b.id);if(!l||!['failed','unknown'].includes(l.status))throw Error('Ce mail ne peut pas être relancé dans son état actuel.');l.status='queued';l.error='';l.updated=now_();saveLog_(l);return {message:'Mail remis dans la file. Vérifiez auparavant les messages envoyés dans Gmail pour éviter un doublon.'};}
 throw Error('Action inconnue.');
}
function variables_(r){const s=getSettings_(),url=s.siteUrl.replace(/\/+$/,'');return {contact_nom:r.runners[0].first+' '+r.runners[0].last,reference:r.id,format:r.kind==='solo'?'Individuel':'Équipe de 4 — '+r.team,coureurs:r.runners.map(n=>n.first+' '+n.last).join(', '),montant:r.amount.toFixed(2).replace('.',','),supplements:String(r.extra_sausages||0),iban:s.iban,beneficiaire:s.beneficiary,lien_parcours:url+'/parcours.html',lien_reglement:url+'/reglement.html',lien_infos:url+'/infos.html',contact_organisation:s.contact};}
function render_(text,v){return text.replace(/{{([a-z_]+)}}/g,(m,k)=>v[k]==null?m:String(v[k]));}
function enqueueReminders_(){const now=new Date(),date=Utilities.formatDate(now,'Europe/Brussels','yyyy-MM-dd'),hour=Number(Utilities.formatDate(now,'Europe/Brussels','H'));if(hour<10)return;let type=date==='2027-04-17'?'j14':date==='2027-04-30'?'j1':null;if(type)records_().filter(r=>r.status==='paid'&&r.mail==='sent').forEach(r=>queue_(r,type));}
function drainQueue_(){if(!ready_())return 0;let count=0;for(const l of logs_().filter(l=>l.status==='queued').slice(0,15)){let r=records_().find(r=>r.id===l.registration_id);if(!r||r.status==='cancelled'||l.type==='received'&&r.status==='paid'||l.type!=='received'&&r.status!=='paid'||['j14','j1'].includes(l.type)&&r.mail!=='sent'){l.status='skipped';l.updated=now_();saveLog_(l);continue;}const t=getTemplates_()[l.type],v=variables_(r);l.status='sending';l.updated=now_();saveLog_(l);try{const sender=Session.getEffectiveUser().getEmail().toLowerCase();if(sender!==EXPECTED_FROM)throw Error('Le script doit être exécuté depuis le compte '+EXPECTED_FROM+' (compte actuel : '+sender+').');if(MailApp.getRemainingDailyQuota()<1)throw Error('Quota quotidien Gmail épuisé.');MailApp.sendEmail({to:r.email,subject:render_(t.subject,v),body:render_(t.body,v),name:'Pionniers de Magnée',replyTo:EXPECTED_FROM});l.status='sent';l.error='';l.sent_at=now_();}catch(e){l.status='unknown';l.error='Envoi interrompu ou résultat incertain : vérifier les messages envoyés dans Gmail avant de relancer.';}l.updated=now_();saveLog_(l);if(l.type==='received')r.received_mail=l.status;if(l.type==='confirmed')r.mail=l.status;saveRecord_(r);count++;}return count;}
function traiterMails(){const lock=LockService.getScriptLock();if(!lock.tryLock(1000))return;try{enqueueReminders_();drainQueue_();}finally{lock.releaseLock();}}
function initialiser(){const ss=SpreadsheetApp.getActiveSpreadsheet();if(!ss)throw Error('Ouvrez Apps Script depuis le Google Sheet.');props_().setProperty('SPREADSHEET_ID',ss.getId());if(!props_().getProperty('ADMIN_KEY'))props_().setProperty('ADMIN_KEY',Utilities.getUuid()+Utilities.getUuid());sheet_('Inscriptions',REG_HEADERS);docs_();logs_();results_();if(readDoc_('gpx',null)===null)writeDoc_('gpx',DEFAULT_GPX);if(readDoc_('settings',null)===null)writeDoc_('settings',JSON.stringify(DEFAULT_SETTINGS));if(readDoc_('templates',null)===null)writeDoc_('templates',JSON.stringify(DEFAULT_TEMPLATES));if(readDoc_('pages',null)===null)writeDoc_('pages',JSON.stringify(DEFAULT_CONTENTS));console.log('Initialisation terminée. La clé organisateur est dans les propriétés du script : ADMIN_KEY. Aucun mail ni rappel n’a été activé.');}

// À exécuter manuellement une seule fois depuis le compte Gmail organisateur.
function autoriserGmail(){
 const sender=Session.getEffectiveUser().getEmail().toLowerCase();
 if(sender!==EXPECTED_FROM)throw Error('Connectez-vous au compte '+EXPECTED_FROM+' pour autoriser les envois. Compte actuel : '+sender);
 const quota=MailApp.getRemainingDailyQuota();
 if(quota<1)throw Error('Quota Gmail indisponible.');
 props_().setProperty('GMAIL_AUTHORIZED','true');
 console.log('Gmail autorisé pour '+sender+'. Quota restant aujourd’hui : '+quota+' destinataires. Aucun email de test n’a été envoyé.');
}
